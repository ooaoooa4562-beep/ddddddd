# Python cache and compiled files\n__pycache__/\n*.py[cod]\n*$py.class\n\n# Virtual environments\n.venv/\nvenv/\nenv/\nENV/\n\n# Environment variables and secrets\n.env\n.env.*\n!.env.example\n\n# Build and packaging\nbuild/\ndist/\n*.egg-info/\n.eggs/\n\n# Test and coverage output\n.pytest_cache/\n.coverage\nhtmlcov/\n.tox/\n\n# Editors and operating systems\n.vscode/\n.idea/\n.DS_Store\nThumbs.db\n